# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — Motor de matching IA
ANTHROPIC_API_KEY=sk-ant-...

# Resend — Email de notificaciones a empresas
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=notificaciones@laborapp.cl

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth Google (configurar en console.cloud.google.com)
# Redirect URI: https://your-project.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth LinkedIn (configurar en linkedin.com/developers)
# Redirect URI: https://your-project.supabase.co/auth/v1/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
